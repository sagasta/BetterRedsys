<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <!-- NuGet Metadata -->
    <PackageId>BetterRedsys</PackageId>
    <Title>BetterRedsys - Modern Redsys &amp; Bizum Payment Gateway for .NET 10 and ASP.NET Core</Title>
    <Description>Modern, strongly-typed, high-performance, and Native AOT library for Redsys and Bizum payment gateway in ASP.NET Core and .NET 10. Designed for both traditional backends and decoupled architectures (React, Next.js, Blazor, Vue, Mobile). Librería moderna de pagos Redsys y Bizum.</Description>
    <PackageTags>redsys;bizum;tpv;pagos;payments;payment-gateway;csharp;dotnet;aspnetcore;tpv-virtual;aot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    
    <!-- Build & Packaging Options -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>BetterRedsys.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
  </ItemGroup>

</Project>
